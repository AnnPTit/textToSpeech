{
  "manifest_version": 3,
  "name": "My First Chrome Extension",
  "version": "1.0",
  "description": "Hello từ tiện ích mở rộng!",
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "web_accessible_resources": [
  {
    "resources": ["fonts/static/Roboto-Italic.ttf"],
    "matches": ["<all_urls>"]
  }
  ],
  "permissions": ["storage", "activeTab", "scripting"]
}
